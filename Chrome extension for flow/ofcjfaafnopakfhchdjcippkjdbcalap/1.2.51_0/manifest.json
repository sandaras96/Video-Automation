{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_title": "ViralDNA Auto Flow"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "content_scripts": [ {
      "js": [ "content/content.js" ],
      "matches": [ "*://labs.google/*", "*://*.labs.google/*", "*://flow.google.com/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Batch-automate your prompts in Google Flow: queue prompts, auto-attach a reference image, and auto-download every result.",
   "host_permissions": [ "*://labs.google/*", "*://*.labs.google/*", "*://flow.google.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ViralDNA Auto Flow",
   "permissions": [ "storage", "unlimitedStorage", "activeTab", "notifications", "alarms", "scripting", "sidePanel", "downloads", "identity", "power" ],
   "side_panel": {
      "default_path": "sidepanel/sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.51"
}
